{
  "expo": {
    "name": "TimoTalk",
    "slug": "lingoloop",
    "scheme": ["timotalk", "lingoloop"],
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0d0c"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lingoloop.app",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.lingoloop.app",
      "adaptiveIcon": {
        "backgroundColor": "#0b0d0c",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-localization",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "TimoTalk에서 대화에 보낼 사진을 선택할 수 있도록 사진 접근을 허용해 주세요.",
          "cameraPermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "TimoTalk에서 음성 메시지를 녹음할 수 있도록 마이크 접근을 허용해 주세요."
        }
      ],
      "expo-system-ui"
    ]
  }
}
